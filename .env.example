# Copy to .env and replace all values before use. Never commit secrets.
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
DATABASE_URL=postgresql://gplan:gplan_local_password@localhost:5432/gplan?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGIN=http://localhost:3000
# Configure only when the corresponding integration is implemented.
OPENAI_API_KEY=
PIXVERSE_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
ADMIN_KEY=
BREVO_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=
